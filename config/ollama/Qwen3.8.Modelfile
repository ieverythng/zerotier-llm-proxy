# Ollama import recipe for the Watson Qwen3.8 IQ3_S GGUF.
# The source file is kept in D:\MODELS and is not copied into this repository.
FROM D:/MODELS/Qwen3.8-27B-UD-IQ3_S.gguf

PARAMETER num_ctx 100096
PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER min_p 0
PARAMETER repeat_penalty 1
